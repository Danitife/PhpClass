# Example .env file that attackers look for
# In real production, this would contain DB passwords, API keys, secrets
# DO NOT COMMIT THIS TO GIT

APP_ENV=production
APP_DEBUG=true
APP_URL=http://internal.company.com

DB_CONNECTION=mysql
DB_HOST=db.internal.corp
DB_PORT=3306
DB_DATABASE=production_database
DB_USERNAME=db_user
DB_PASSWORD=replace_with_database_password

CACHE_DRIVER=redis
REDIS_HOST=redis.internal.corp
REDIS_PASSWORD=replace_with_redis_password

API_KEY_STRIPE=replace_with_stripe_key
API_KEY_SENDGRID=replace_with_sendgrid_key
API_KEY_OPENAI=replace_with_openai_key

JWT_SECRET=replace_with_random_jwt_secret
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

AWS_ACCESS_KEY_ID=replace_with_aws_access_key_id
AWS_SECRET_ACCESS_KEY=replace_with_aws_secret_access_key
AWS_DEFAULT_REGION=us-east-1

MAIL_DRIVER=smtp
MAIL_HOST=mail.company.internal
MAIL_PORT=587
MAIL_USERNAME=app@company.internal
MAIL_PASSWORD=replace_with_mail_password
